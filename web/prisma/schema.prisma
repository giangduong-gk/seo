// Sprint 1 dùng SQLite để chạy ngay không cần dịch vụ ngoài.
// Production: đổi provider thành "postgresql" và cập nhật DATABASE_URL (xem docs/PLAN.md).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id            String     @id @default(cuid())
  name          String
  domain        String?
  industry      String?
  locale        String     @default("vi-VN")
  brandVoice    String?
  entityProfile String?    // JSON: tên doanh nghiệp, sản phẩm, tác giả, sameAs...
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  keywords      Keyword[]
  analyses      Analysis[]
  usage         AiUsage[]
  clusters      Cluster[]
  briefs        Brief[]
  articles      Article[]
}

model Keyword {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  term      String
  intent    String?
  source    String     @default("manual")
  createdAt DateTime   @default(now())
  analyses  Analysis[]

  @@unique([projectId, term])
}

model Analysis {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keywordId String
  keyword   Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  status    String   @default("done") // done | failed | refused
  model     String
  research  String?  // ghi chú SERP (text) nếu bật web search
  result    String?  // JSON KeywordAnalysis
  error     String?
  createdAt DateTime @default(now())
}

model AiUsage {
  id              String   @id @default(cuid())
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  feature         String
  model           String
  inputTokens     Int
  outputTokens    Int
  cacheReadTokens Int      @default(0)
  cacheWriteTokens Int     @default(0)
  costUsd         Float
  createdAt       DateTime @default(now())
}

model Cluster {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  pillarKeyword String
  model         String
  data          String   // JSON ClusterMap (kèm vị trí node đã kéo)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  briefs        Brief[]
}

model Brief {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clusterId     String?
  cluster       Cluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  targetKeyword String
  title         String
  model         String
  data          String   // JSON ContentBrief
  createdAt     DateTime @default(now())
  articles      Article[]
}

model Article {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  briefId       String?
  brief         Brief?    @relation(fields: [briefId], references: [id], onDelete: SetNull)
  targetKeyword String
  title         String
  slug          String
  metaDescription String  @default("")
  bodyMarkdown  String    @default("")
  jsonLd        String?   // JSON-LD sinh bằng code từ bài + hồ sơ dự án
  status        String    @default("draft") // draft | writing | review | final
  model         String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  revisions     ArticleRevision[]
  scores        Score[]
}

model ArticleRevision {
  id           String   @id @default(cuid())
  articleId    String
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  bodyMarkdown String
  note         String
  createdAt    DateTime @default(now())
}

model Score {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  seoScore  Int
  geoScore  Int
  criteria  String   // JSON ScoreCriterion[]
  model     String?
  createdAt DateTime @default(now())
}
