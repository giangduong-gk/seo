# Bắt buộc
ANTHROPIC_API_KEY=sk-ant-...
# Postgres — schema `seo` (?schema=seo). Dev cục bộ: cùng một URL cho cả hai biến.
DATABASE_URL="postgresql://seo:seo@localhost:5432/seo_dev?schema=seo"
DIRECT_URL="postgresql://seo:seo@localhost:5432/seo_dev?schema=seo"
# Supabase (Dashboard → Connect):
#  - DATABASE_URL = Supavisor transaction pooler (cổng 6543) cho runtime/serverless:
#    postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=seo
#  - DIRECT_URL   = kết nối session (cổng 5432) cho `prisma migrate deploy`:
#    postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=seo
# Không bao giờ commit mật khẩu DB hay service_role key.

# Tuỳ chọn
# Model cho phân tích sâu (mặc định claude-opus-5-5)
CLAUDE_MODEL_ANALYSIS=claude-opus-5-5
# Bật bước nghiên cứu SERP bằng Claude web search (tốn thêm token). true | false
ENABLE_WEB_SEARCH=true
# Giới hạn số lần web search mỗi phân tích
WEB_SEARCH_MAX_USES=5
