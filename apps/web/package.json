{
  "name": "rankmind-web",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ux": "playwright test tests/e2e/a11y.spec.ts tests/e2e/layout.spec.ts tests/e2e/motion.spec.ts tests/e2e/keyboard.spec.ts tests/e2e/visual.spec.ts",
    "ux:report": "node scripts/ux-report.mjs",
    "typecheck": "tsc --noEmit -p .",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.mjs",
    "check": "npm run typecheck && npm test && npm run lint:tokens"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@prisma/client": "^6.19.3",
    "@xyflow/react": "^12.8.4",
    "lucide-react": "^1.55.0",
    "marked": "^16.4.1",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "prisma": "^6.19.3",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
